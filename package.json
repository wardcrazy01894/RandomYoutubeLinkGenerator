{
  "name": "randomyoutubelinkgenerator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "description": "A button that gives you a genuinely random YouTube video — uniform sampling of YouTube's public corpus, not a curated list.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "harvest": "node scripts/harvest.mjs",
    "revalidate": "node scripts/revalidate.mjs",
    "pool-stats": "node scripts/pool-stats.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
